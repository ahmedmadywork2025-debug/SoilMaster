<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    android:background="@drawable/bg_gradient_main"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اختبارات معمل التربة"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="24dp"
        android:gravity="center"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/openTestButton"
                style="@style/PrimaryButton"
                android:text="Sand Cone Test"
                android:drawableStart="@drawable/ic_sand"
                android:drawablePadding="8dp"/>

            <Button
                android:id="@+id/RelativeSand"
                style="@style/PrimaryButton"
                android:text="Relative Density Test"
                android:drawableStart="@drawable/ic_density"
                android:drawablePadding="8dp"/>

            <Button
                android:id="@+id/openLiquidLimitButton"
                style="@style/PrimaryButton"
                android:text="Liquid Limit Test"
                android:drawableStart="@drawable/ic_liquid"
                android:drawablePadding="8dp"/>

            <Button
                android:id="@+id/classificationTestButton"
                style="@style/PrimaryButton"
                android:text="Classification Test"
                android:drawableStart="@drawable/ic_classification"
                android:drawablePadding="8dp"/>

            <Button
                android:id="@+id/cbrtestbtn"
                style="@style/PrimaryButton"
                android:text="CBR Test"
                android:drawableStart="@drawable/ic_cbr"
                android:drawablePadding="8dp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnInfo"
        style="@style/SecondaryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="معلومات عنا"
        android:layout_marginTop="24dp"
        android:drawableStart="@drawable/ic_info"
        android:drawablePadding="8dp"/>

</LinearLayout>
