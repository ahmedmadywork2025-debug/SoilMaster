<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Dark Mode Theme -->
    <style name="Theme.SandConeTest2" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorOnPrimary">@color/textOnPrimary</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorSecondaryVariant">@color/secondaryVariant</item>
        <item name="colorOnSecondary">@color/textOnPrimary</item>
        
        <!-- Background Colors -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primaryVariant</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:textColorHint">@color/textHint</item>
        
        <!-- Button Styles -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MaterialComponents.Button.OutlinedButton</item>
        
        <!-- Card Style -->
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        
        <!-- App Bar Style -->
        <item name="materialAppBarStyle">@style/Widget.MaterialComponents.AppBarLayout</item>
    </style>

</resources>
